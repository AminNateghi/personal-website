---
import MainLayout from "@layouts/MainLayout.astro";
import { render, type CollectionEntry } from "astro:content";
import IconLeft from "@assets/images/icon-round-arrow-left.svg";
import IconRight from "@assets/images/icon-round-arrow-right.svg";

interface Props {
  post: CollectionEntry<"blog">;
  translatedUrl: string;
}

const { post, translatedUrl } = Astro.props;
const { Content } = await render(post);

const lang = post.data.lang;
const isPersian = lang === "fa";

const blogHome = isPersian ? "/fa/blog/" : "/blog/";
---

<MainLayout title={post.data.title} description={post.data.description}>
  <main class="post-blog">
    <article>
      <div class="title">
        {
          isPersian ? (
            <a class="link-back" href={blogHome}>
              <IconRight />
              برگشت به وبلاگ
            </a>
          ) : (
            <a class="link-back" href={blogHome}>
              <IconLeft />
              Back to Blog
            </a>
          )
        }
      </div>

      <div class="prose">
        <Content />
      </div>

      <div class="article-footer">
        <time datetime={post.data.pubDate.toISOString()}>
          {
            post.data.pubDate.toLocaleDateString(
              isPersian ? "fa-IR" : "en-US",
              {
                year: "numeric",
                month: "long",
                day: "numeric",
              },
            )
          }
        </time>
        <div class="tags">
          {post.data.tags?.map((tag) => <div class="tag">{tag}</div>)}
        </div>
      </div>
    </article>
  </main>
</MainLayout>

<style>
  .link-back {
    display: flex;
    align-items: center;
    background-color: var(--color-base-200);
    gap: 4px;
    border-radius: 20px;
    margin-bottom: 10px;
    padding-inline-end: 10px;
    color: var(--color-text);
  }

  .article-footer {
    border-top: 1px solid var(--color-base-400);
    margin-top: 10px;
    padding-top: 10px;
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  article {
    width: 100%;
  }

  .title {
    display: flex;
    flex-direction: row;
    gap: 5px;
  }

  time {
    font-size: 12px;
  }

  .prose {
    img {
      max-width: 100%;
      height: auto;
    }

    h1 {
      font-size: 22px;
    }

    p code {
      background-color: var(--color-base-200);
      padding: 1px 5px;
    }

    a {
      display: inline-block;
      background-color: var(--color-base-200);
      padding: 0 5px 1px;
      border-radius: 4px;
      border-bottom: 1px solid var(--color-base-400);
      color: var(--color-text);
    }

    pre {
      text-align: left;
      overflow-x: auto;
      padding: 1rem;
      border-radius: 0.5rem;
      margin-top: 10px;
      margin-bottom: 10px;
    }
  }

  @media (min-width: 1224px) {
    .title {
      width: 450px;
    }
  }
</style>
