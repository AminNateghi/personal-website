---
import IconMoon from "@assets/images/icon-moon.svg";
import IconSun from "@assets/images/icon-sun.svg";
import IconLayers from "@assets/images/icon-layers.svg";
import IconLayer from "@assets/images/icon-layer.svg";
import IconClose from "@assets/images/icon-close.svg";
import IconMenu from "@assets/images/icon-menu-dots-circle.svg";

import { getLocaleFromUrl, getLocalePath, useTranslations } from "@i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const switchLocale = locale === "en" ? "fa" : "en";
const switchHref = getLocalePath(Astro.url.pathname, switchLocale);
---

<nav class="navbar" aria-label="Main navigation">
  <ul class="navbar-list">
    <li class="navbar-item">
      <a class="navbar-link" href={getLocalePath("/", locale)}>
        {t("nav.about")}
      </a>
    </li>

    <li class="navbar-item">
      <a class="navbar-link" href={getLocalePath("/resume/", locale)}>
        {t("nav.resume")}
      </a>
    </li>

    <li class="navbar-item">
      <a class="navbar-link" href={getLocalePath("/portfolio/", locale)}>
        {t("nav.portfolio")}
      </a>
    </li>

    <li class="navbar-item">
      <a class="navbar-link" href={getLocalePath("/blog/", locale)}>
        {t("nav.blog")}
      </a>
    </li>

    <!-- Desktop controls -->
    <li class="navbar-item is-desktop">
      <button
        class="control-button"
        type="button"
        data-theme-toggle
        aria-label="Toggle theme"
      >
        <span data-theme-icon="sun" class="theme-icon">
          <IconSun />
        </span>
        <span data-theme-icon="moon" class="theme-icon">
          <IconMoon />
        </span>
      </button>
    </li>

    <li class="navbar-item is-desktop">
      <button
        class="control-button"
        type="button"
        data-aurora-toggle
        aria-label="Toggle aurora"
      >
        <span data-aurora-icon="layers" class="theme-icon">
          <IconLayers />
        </span>
        <span data-aurora-icon="layer" class="theme-icon">
          <IconLayer />
        </span>
      </button>
    </li>

    <li class="navbar-item is-desktop">
      <a
        class="navbar-link lang-link"
        href={switchHref}
        data-locale={switchLocale}
      >
        {switchLocale === "fa" ? t("nav.lang.fa") : t("nav.lang.en")}
      </a>
    </li>

    <!-- Mobile menu button -->
    <li class="navbar-item is-mobile">
      <button
        id="toggleMore"
        class="more-button"
        type="button"
        aria-label="Open more options"
        aria-controls="navbarMore"
        aria-expanded="false"
      >
        <span class="menu-icon menu-icon-open">
          <IconMenu />
        </span>

        <span class="menu-icon menu-icon-close">
          <IconClose />
        </span>
      </button>
    </li>
  </ul>
</nav>

<!-- Mobile additional options -->
<nav
  id="navbarMore"
  class="navbar-more"
  aria-label="Additional navigation options"
  aria-hidden="true"
  inert
>
  <ul class="navbar-list">
    <li class="navbar-item">
      <button
        class="control-button"
        type="button"
        data-theme-toggle
        aria-label="Toggle theme"
      >
        <span data-theme-icon="sun" class="theme-icon">
          <IconSun />
        </span>
        <span data-theme-icon="moon" class="theme-icon">
          <IconMoon />
        </span>
      </button>
    </li>

    <li class="navbar-item">
      <button
        class="control-button"
        type="button"
        data-aurora-toggle
        aria-label="Toggle aurora"
      >
        <span data-aurora-icon="layers" class="theme-icon">
          <IconLayers />
        </span>
        <span data-aurora-icon="layer" class="theme-icon">
          <IconLayer />
        </span>
      </button>
    </li>

    <li class="navbar-item">
      <a
        class="navbar-link lang-link"
        href={switchHref}
        data-locale={switchLocale}
      >
        {switchLocale === "fa" ? t("nav.lang.fa") : t("nav.lang.en")}
      </a>
    </li>
  </ul>
</nav>

<style lang="scss">
  .navbar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--color-bg-nav);
    backdrop-filter: blur(10px);
    border-radius: 12px 12px 0 0;
    z-index: 5;
  }

  .navbar-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 20px;
    height: 54px;
    padding: 0 10px;
    list-style: none;
    margin: 0;
  }

  .navbar-item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .is-desktop {
    display: none;
  }

  .is-mobile {
    display: flex;
  }

  .navbar-link {
    color: var(--color-text);
    transition: color 0.3s ease;

    &.active {
      color: var(--color-text);
      border-bottom: 2px solid var(--color-base-400);
    }
  }

  .control-button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .theme-icon {
    display: none;
    grid-area: 1 / 1;
    place-items: center;
  }

  .theme-icon.active {
    display: grid;
  }

  .control-button svg {
    width: 24px;
    height: 24px;
  }

  .lang-link {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.6px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile additional menu */
  .navbar-more {
    position: fixed;
    bottom: 70px;
    left: 50%;
    width: 200px;
    transform: translate(-50%, 16px);

    background: var(--color-bg-nav);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    z-index: 6;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 250ms ease,
      transform 250ms ease,
      visibility 0s linear 250ms;
  }

  .navbar-more.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);

    transition:
      opacity 250ms ease,
      transform 250ms ease,
      visibility 0s;
  }

  .navbar-more .navbar-list {
    flex-direction: row;
    height: auto;
    padding: 15px;
    gap: 15px;
  }

  /* More menu button */
  .more-button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-icon {
    display: grid;
    place-items: center;
    grid-area: 1 / 1;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .menu-icon-open {
    opacity: 1;
    transform: rotate(0deg);
  }

  .menu-icon-close {
    opacity: 0;
    transform: rotate(-90deg);
    pointer-events: none;
  }

  #toggleMore[aria-expanded="true"] .menu-icon-open {
    opacity: 0;
    transform: rotate(90deg);
    pointer-events: none;
  }

  #toggleMore[aria-expanded="true"] .menu-icon-close {
    opacity: 1;
    transform: rotate(0deg);
    pointer-events: auto;
  }

  /* Desktop */
  @media (min-width: 1224px) {
    .navbar {
      position: absolute;
      top: 0;
      right: 0;
      bottom: auto;
      left: auto;
      width: max-content;
      padding: 0 20px;
      background: var(--color-base-200);
      border-radius: 0 12px;
    }

    .is-desktop {
      display: flex;
    }

    .is-mobile {
      display: none;
    }

    .navbar-more {
      display: none;
    }

    html[dir="rtl"] .navbar {
      right: auto;
      left: 0;
      border-radius: 12px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-more,
    .menu-icon,
    .navbar-link {
      transition: none;
    }
  }
</style>

<script>
  const toggleButton = document.querySelector<HTMLButtonElement>("#toggleMore");

  const moreMenu = document.querySelector<HTMLElement>("#navbarMore");

  if (toggleButton && moreMenu) {
    const mobileQuery = window.matchMedia("(max-width: 1223px)");

    const setMenuOpen = (open: boolean) => {
      toggleButton.setAttribute("aria-expanded", String(open));

      toggleButton.setAttribute(
        "aria-label",
        open ? "Close more options" : "Open more options",
      );

      moreMenu.classList.toggle("is-open", open);
      moreMenu.setAttribute("aria-hidden", String(!open));
      moreMenu.inert = !open;
    };

    toggleButton.addEventListener("click", () => {
      const isOpen = toggleButton.getAttribute("aria-expanded") === "true";

      setMenuOpen(!isOpen);
    });

    // Close menu when clicking outside.
    document.addEventListener("click", (event) => {
      const target = event.target;

      if (
        target instanceof Node &&
        !moreMenu.contains(target) &&
        !toggleButton.contains(target)
      ) {
        setMenuOpen(false);
      }
    });

    // Close menu with Escape.
    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        toggleButton.getAttribute("aria-expanded") === "true"
      ) {
        setMenuOpen(false);
        toggleButton.focus();
      }
    });

    // Close menu when navigating.
    moreMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    // Keep menu closed when switching to desktop.
    mobileQuery.addEventListener("change", (event) => {
      if (!event.matches) {
        setMenuOpen(false);
      }
    });
  }
</script>

<script src="@assets/scripts/theme.js"></script>
<script src="@assets/scripts/aurora.js"></script>
