---
import IconMoon from "@assets/images/icon-moon.svg";
import IconSun from "@assets/images/icon-sun.svg";
import IconLayers from "@assets/images/icon-layers.svg";
import IconLayer from "@assets/images/icon-layer.svg";
import IconClose from "@assets/images/icon-close.svg";
import IconMenu from "@assets/images/icon-menu-dots-circle.svg";
import { getLocaleFromUrl, getLocalePath, useTranslations } from "@i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const switchLocale = locale === "en" ? "fa" : "en";
const switchHref = getLocalePath(Astro.url.pathname, switchLocale);
---

<nav class="navbar">
  <ul class="navbar-list">
    <li class="navbar-item">
      <a class="navbar-link" href={getLocalePath("/", locale)}>
        {t("nav.about")}
      </a>
    </li>

    <li class="navbar-item">
      <a class="navbar-link" href={getLocalePath("/resume/", locale)}>
        {t("nav.resume")}
      </a>
    </li>

    <li class="navbar-item">
      <a class="navbar-link" href={getLocalePath("/portfolio/", locale)}>
        {t("nav.portfolio")}
      </a>
    </li>

    <li class="navbar-item">
      <a class="navbar-link" href={getLocalePath(`/blog/`, locale)}>
        {t("nav.blog")}
      </a>
    </li>

    <li class="navbar-item">
      <li>
        <button
          id="toggleMore"
          type="button"
          aria-label="Open more options"
          aria-controls="navbarMore"
          aria-expanded="false"
        >
          <span class="menu-icon menu-icon-open">
            <IconMenu />
          </span>
          <span class="menu-icon menu-icon-close">
            <IconClose />
          </span>
        </button>
      </li>
    </li>
  </ul>
</nav>

<nav id="navbarMore" class="navbar-more" aria-hidden="true" inert>
  <ul class="navbar-list">
    <li>
      <button id="toggleTheme" type="button">
        <div id="iconSun" class="theme-icon"><IconSun /></div>
        <div id="iconMoon" class="theme-icon"><IconMoon /></div>
      </button>
    </li>
    <li>
      <button id="toggleAurora" type="button">
        <div id="iconLayers" class="theme-icon"><IconLayers /></div>
        <div id="iconLayer" class="theme-icon"><IconLayer /></div>
      </button>
    </li>
    <li>
      <a
        id="toggleLanguage"
        class="navbar-link lang-link"
        href={switchHref}
        data-locale={switchLocale}
      >
        {switchLocale === "fa" ? t("nav.lang.fa") : t("nav.lang.en")}
      </a>
    </li>
  </ul>
</nav>

<style lang="scss">
  .navbar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--color-bg-nav);
    backdrop-filter: blur(10px);
    border-radius: 12px 12px 0 0;
    z-index: 5;
  }

  .navbar-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    padding: 0 10px;
    list-style: none;
    height: 54px;
    gap: 20px;
  }

  .navbar-link {
    color: var(--color-text);
    transition: color 0.5s ease;

    &.active {
      color: var(--color-text);
      border-bottom: 2px solid var(--color-base-400);
    }
  }

  #toggleAurora,
  #toggleTheme {
    width: 24px;
    height: 24px;
  }

  .theme-icon {
    display: none;
  }

  .theme-icon.active {
    display: block;
  }

  .lang-link {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.6px;
    color: var(--color-text);
  }

  .navbar-more {
    position: fixed;
    bottom: 70px;
    left: 50%;
    transform: translate(-50%, 16px);
    width: 200px;

    background: var(--color-bg-nav);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    z-index: 6;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 250ms ease,
      transform 250ms ease,
      visibility 0s linear 250ms;
  }

  .navbar-more.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);

    transition:
      opacity 250ms ease,
      transform 250ms ease,
      visibility 0s;
  }

  /* Toggle menu icons */
  #toggleMore {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  /* Default: menu closed */
  .menu-icon-open {
    opacity: 1;
    transform: rotate(0deg);
  }

  .menu-icon-close {
    opacity: 0;
    transform: rotate(-90deg);
    pointer-events: none;
  }

  /* Menu open */
  #toggleMore[aria-expanded="true"] .menu-icon-open {
    opacity: 0;
    transform: rotate(90deg);
    pointer-events: none;
  }

  #toggleMore[aria-expanded="true"] .menu-icon-close {
    opacity: 1;
    transform: rotate(0deg);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-more,
    .menu-icon {
      transition: none;
    }
  }

  @media (min-width: 1224px) {
    .navbar {
      position: absolute;
      bottom: auto;
      top: 0;
      left: auto;
      right: 0;
      width: max-content;
      border-radius: 0 12px;
      padding: 0 20px;
      background: var(--color-base-200);
    }

    html[dir="rtl"] {
      .navbar {
        top: 0;
        left: 0;
        right: auto;
        border-radius: 12px 0;
      }

      .navbar-more {
        position: absolute;
        top: 2px;
        right: unset;
        left: -150px;
        transform: translate(240px, 0px);
        width: 270px;
      }
    }

    .navbar-more {
      position: absolute;
      top: 2px;
      left: auto;
      right: -70px;
      transform: translate(220px, 0px);
      width: 300px;
      height: 50px;
    }
  }
</style>

<script>
  const toggleButton = document.querySelector<HTMLButtonElement>("#toggleMore");
  const moreMenu = document.querySelector<HTMLElement>("#navbarMore");

  if (toggleButton && moreMenu) {
    const setMenuOpen = (open: boolean) => {
      toggleButton.setAttribute("aria-expanded", String(open));
      toggleButton.setAttribute(
        "aria-label",
        open ? "Close more options" : "Open more options",
      );

      moreMenu.classList.toggle("is-open", open);
      moreMenu.setAttribute("aria-hidden", String(!open));
      moreMenu.inert = !open;
    };

    toggleButton.addEventListener("click", () => {
      const isOpen = toggleButton.getAttribute("aria-expanded") === "true";

      setMenuOpen(!isOpen);
    });

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        toggleButton.getAttribute("aria-expanded") === "true"
      ) {
        setMenuOpen(false);
        toggleButton.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (
        target instanceof Node &&
        !moreMenu.contains(target) &&
        !toggleButton.contains(target)
      ) {
        setMenuOpen(false);
      }
    });
  }
</script>

<script src="@assets/scripts/theme.js"></script>
<script src="@assets/scripts/aurora.js"></script>
