---
import { getPublishedBlogPosts } from "../lib/blog";
import MainLayout from "@layouts/MainLayout.astro";

interface Props {
  lang: "en" | "fa";
}

const { lang } = Astro.props;
const isPersian = lang === "fa";

const posts = (await getPublishedBlogPosts())
  .filter((post) => post.data.lang === lang)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const title = isPersian ? "وبلاگ" : "Blog";
const description = isPersian
  ? "نوشته‌ها، مقالات و نکته‌های کوتاه و کاربردی برنامه‌نویسی."
  : "Article, Short and practical programming tips.";
---

<MainLayout title={title}>
  <article data-page="blog">
    <header>
      <h2 class="article-title">{title}</h2>
      <p>{description}</p>
    </header>

    {
      posts.length === 0 ? (
        <p>
          {isPersian ? "هنوز مطلبی منتشر نشده است." : "No posts published yet."}
        </p>
      ) : (
        <div class="post-list">
          {posts.map((post) => {
            const slug = post.id.split("/").pop();

            const href = lang === "fa" ? `/fa/blog/${slug}/` : `/blog/${slug}/`;

            return (
              <article class="item">
                <h4 class="title">
                  <a class="link" href={href}>
                    {post.data.title}
                  </a>
                </h4>

                <span class="time">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString(
                      isPersian ? "fa-IR" : "en-US",
                      {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      },
                    )}
                  </time>
                </span>

                <p class="description">{post.data.description}</p>

                <div class="tags">
                  {post.data.tags?.map((tag) => (
                    <div class="tag">{tag}</div>
                  ))}
                </div>
              </article>
            );
          })}
        </div>
      )
    }
  </article>
</MainLayout>

<style>
  .post-list {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 16px;

    .item {
      position: relative;
      padding: 20px;
      z-index: 1;
      display: flex;
      flex-direction: column;
      width: 100%;
      border: 1px solid transparent;

      &:hover {
        border: 1px solid var(--color-base-400);
      }

      &::before {
        content: "";
        position: absolute;
        inset: 1px;
        background: var(--color-base-200);
        border-radius: inherit;
        z-index: -1;
      }

      .title {
        font-size: 16px;
        line-height: 1.3;
        margin-bottom: 7px;

        a {
          color: var(--color-text);
        }
      }

      .description {
        font-size: 14px;
        font-weight: 400;
        line-height: 1.6;
      }

      .time {
        font-size: 12px;
      }

      .tag {
        background-color: var(--color-base-300);
      }
    }
  }

  @media (min-width: 1224px) {
    .post-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
