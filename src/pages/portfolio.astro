---
import { Image } from "astro:assets";
import DataProject from "@assets/data/portfolio.json";
import DataProjectFa from "@assets/data/portfolio.fa.json";
import IconLink from "@assets/images/icon-link.svg";
import MainLayout from "@layouts/MainLayout.astro";
import { getLocaleFromUrl, useTranslations } from "@i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const projectData = locale === "fa" ? DataProjectFa : DataProject;
---

<MainLayout title={t("nav.portfolio")}>
  <article data-page="portfolio">
    <header>
      <h2 class="article-title">{t("portfolio.title")}</h2>
    </header>

    {projectData.map((project) => (
      <div class="project-section">
        <div class="content">
          <h3 class="title">
            {project.title}{" "}
            {project.subTitle ? <small>{project.subTitle}</small> : null}
          </h3>
          <p>{project.description}</p>
        </div>

        <div class="project-link-content">
          {project.link?.map((link) => (
            <a
              class="project-link"
              href={link.url}
              target="_blank"
              rel="noreferrer"
            >
              {link.title}
              <IconLink />
            </a>
          ))}
        </div>
        <div class="tags">
          {project.tags?.map((tag) => (
            <div class="tag">{tag}</div>
          ))}
        </div>
        <div class="project-images">
          {project.images?.map((image) => (
            <div data-project-item>
              <Image
                src={{
                  src: image,
                  format: "jpg",
                  width: project.imageAsMobile ? 400 : 1280,
                  height: 0,
                }}
                alt="🖼️"
                loading="lazy"
                class={project.imageAsMobile ? "image-as-mobile" : null}
                data-project-image
              />
            </div>
          ))}
        </div>
      </div>
    ))}
  </article>
</MainLayout>

<style lang="scss">
  article {
    margin-bottom: 425px;
  }
  .project-section {
    .content {
      .title {
        display: flex;
        flex-direction: row;
        gap: 10px;
        align-items: center;
      }

      p {
        margin-top: 5px;
        font-size: 14px;
        font-weight: 400;
        line-height: 1.6;
      }
    }
  }

  .project-link-content {
    display: flex;
    flex-direction: row;
    gap: 10px;
    flex-wrap: wrap;
  }
  .project-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background-color: var(--color-base-200);
    padding: 4px 10px;
    margin: 5px 0 10px 0;
    width: fit-content;
    border-radius: var(--radius-box);
    color: var(--text-active);
    font-size: 14px;
    border-bottom: 1px solid;

    &:hover {
      background-color: var(--color-base-100);
    }
  }

  .project-images {
    margin-top: 16px;
    margin-bottom: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    .image-as-mobile {
      width: 80px;
      height: 142px;
      background-color: var(--color-base-400);
    }

    img {
      border-radius: var(--radius-box);
      filter: saturate(10%) opacity(40%);
      cursor: pointer;
      transition: filter 0.5s ease;
      background-color: var(--color-base-400);
      width: 150px;
      height: 74px;

      &:hover {
        filter: none;
      }
    }
  }

  p,
  h2,
  h3,
  blockquote,
  hr,
  img,
  .project-link,
  .tags {
    animation: text-appear ease-in both;
    animation-timeline: view();
    animation-range: 0vh 30vh;
  }

  @prefers-reduced-motion {
    p,
    h2,
    h3,
    blockquote,
    hr,
    img,
    .project-link,
    .tags {
      animation: none;
    }
  }

  @keyframes text-appear {
    from {
      opacity: 0;
      translate: 0 8rem;
    }
  }
</style>
