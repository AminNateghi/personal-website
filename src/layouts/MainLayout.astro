---
import Nav from "@components/Nav.astro";
import Modal from "@components/Modal.astro";
import SideBar from "@components/SideBar.astro";
import Aurora from "@components/Aurora.astro";
import { getDir, getLocaleFromUrl, useTranslations } from "@i18n/utils";
import "@assets/styles/style.scss";

const locale = getLocaleFromUrl(Astro.url);
const dir = getDir(locale);
const t = useTranslations(locale);

const { title, description = "" } = Astro.props;
---

<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#796a4383" />
    {description && <meta name="description" content={description} />}
    <link
      rel="shortcut icon"
      href="/assets/my-avatar.png"
      type="image/x-icon"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Display:ital,wght@0,100..900;1,100..900&family=Vazirmatn:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <title>{title} | {t("site.title")}</title>
  </head>
  <body>
    <main>
      <SideBar />

      <div class="main-content">
        <Nav />
        <slot />
      </div>
    </main>
    <Modal />
    <Aurora />
  </body>
</html>

<style lang="scss">
  main {
    margin: 0;
    width: 100%;
    padding: 5px;
    margin-bottom: 55px;
  }

  .main-content {
    position: relative;
    margin: auto;
  }

  @media screen and (min-width: 1224px) {
    main {
      max-width: 1200px;
      margin-inline: auto;
      display: flex;
      justify-content: center;
      align-items: stretch;
      gap: 25px;
      margin-top: 60px;
    }

    .main-content {
      min-width: 75%;
      width: 75%;
      margin: 0;
    }
  }
</style>

